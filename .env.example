# -----------------------------------------------------------------------------
# CloudWatch AI Log Intelligence — local configuration
# Copy to .env and adjust. Never commit .env or credentials.
# AWS credentials come from the standard boto3 chain, not this file.
# -----------------------------------------------------------------------------

# Backend
APP_NAME=CloudWatch AI Log Intelligence
APP_VERSION=0.1.0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info
LOG_FORMAT=json

# Frontend (leave empty in local Vite to use the /api proxy)
VITE_API_BASE_URL=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------

# Leave AWS_REGION empty to use the boto3 default chain (AWS_DEFAULT_REGION / config).
# Do not put account IDs or access keys here.
AWS_REGION=
AWS_USE_MOCK=true

# CloudWatch Logs Query Settings
CW_QUERY_TIMEOUT_SECONDS=60
CW_QUERY_MAX_CONCURRENCY=5
CW_QUERY_POLL_INTERVAL_MS=500
CW_QUERY_MAX_LOG_GROUPS=50
CW_QUERY_SCAN_LIMIT_BYTES=10000000000
CW_LOG_GROUPS_PAGE_SIZE=50

# Multi-Account Support (JSON array of account configs)
# Each account must have a pre-configured read-only IAM role that trusts this application.
# Format: [{"account_alias":"name","role_arn":"arn:aws:iam::ACCOUNT:role/ROLE","external_id":"","region":""}]
# Example:
# AWS_ACCOUNTS=[{"account_alias":"prod","role_arn":"arn:aws:iam::123456789012:role/CloudWatchReadOnly","external_id":"secret123","region":"us-east-1"}]
AWS_ACCOUNTS=[]

# -----------------------------------------------------------------------------
# AI Configuration (interfaces only - not wired yet)
# -----------------------------------------------------------------------------

AI_PROVIDER=bedrock
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
STRANDS_ENABLED=false
